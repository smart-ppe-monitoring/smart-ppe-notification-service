NODE_ENV=development
PORT=8894
NOTIFICATION_PORT=8894
NOTIFICATION_DATABASE_URL="postgresql://notification_user:notification_password@localhost:5433/notification_db?schema=public"

# Notification Worker
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_WORKER_INTERVAL_MS=5000

# Redis & Event Bus
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# SMTP / Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Smart PPE Safety Alert <no-reply@smart-ppe.local>"
APP_URL=http://localhost:3000

# Security & Gateway
GATEWAY_INTERNAL_SECRET=smart_ppe_gateway_secret_key_change_me
TRUST_PROXY=1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
ENCRYPTION_KEY=your_encryption_key_min_32_characters_for_outbox

# Auth Verification & Stream Ticket
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_long
JWT_TEMP_SECRET=your_jwt_temp_secret_for_sse_stream_tickets
AUTH_JWKS_URL=http://localhost:9999/.well-known/jwks.json
